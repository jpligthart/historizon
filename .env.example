# Image registry for multi-arch push / prod pull
IMAGE_REGISTRY=ghcr.io/example
IMAGE_TAG=latest
IMAGE_PLATFORMS=linux/amd64,linux/arm64

# API
PORT=3000
SQLITE_PATH=/data/historizon.sqlite
# Sent to Wikipedia/Wikidata. Wikimedia requires contact info (URL or e-mail) and gives
# clients without it much lower rate limits. Use your own instance URL / contact address.
WIKI_USER_AGENT=Historizon/0.1 (https://github.com/example/historizon; contact@example.com)
# SPARQL endpoint for viewport discovery. Default: QLever (fast); the official
# query.wikidata.org times out on these queries.
# WIKIDATA_SPARQL_URL=https://qlever.dev/api/wikidata
# Minimum ms between SPARQL queries (QLever rate-limits at roughly 8+/minute).
# SPARQL_MIN_INTERVAL_MS=6000

# Web (compose host binding — TIME on phone keypad)
WEB_HOST_PORT=8463
