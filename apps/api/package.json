{
  "name": "@historizon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-sqlite --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --experimental-sqlite --import tsx/esm src/seed.ts",
    "ingest": "node --experimental-sqlite --import tsx/esm src/ingest.ts"
  },
  "dependencies": {
    "@historizon/shared": "*",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
